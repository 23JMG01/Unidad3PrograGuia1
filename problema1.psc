Algoritmo sin_titulo
	Definir n Como Entero
	Definir estuche Como Caracter
	Dimensionar estuche[8]
	estuche[8] = "Amarillo"
	estuche[7] = "Naranja"
	estuche[6] = "rojo"
	estuche[5] = "Morado"
	estuche[4] = "azul"
	estuche[3] = "Verde"
	estuche[2] = "marron"
	estuche[1] = "negro"
	Escribir Sin Saltar"Dame un numero del 1 al 8: "
	leer n
	Escribir "el color de la casilla es el: ", estuche[n]


	
FinAlgoritmo
